{
    "name": "supertype",
    "displayName": "supertype-syntax-highlighting",
    "description": "",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "supertype",
            "aliases": ["SuperType", "supertype"],
            "extensions": [".st"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "supertype",
            "scopeName": "source.st",
            "path": "./syntaxes/supertype.tmLanguage.json"
        }],
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": "mixin.tag.st",
                        "settings": {
                            "foreground": "#46e891",
                            "fontStyle": ""
                        }
                    },
                    {
                        "scope": "param.mixin.st",
                        "settings": {
                            "foreground": "#ffab89",
                            "fontStyle": "bold"
                        }
                    },
                    {
                        "scope": "comment.block.supertype",
                        "settings": {
                            "fontStyle": ""
                        }
                    },
                    {
                        "scope": "specific.st",
                        "settings": {
                            "foreground": "#ff6f6f",
                            "fontStyle": ""
                        }
                    },
                    {
                        "scope": "color.st",
                        "settings": {
                            "foreground": "#f27aff",
                            "fontStyle": ""
                        }
                    },
                    {
                        "scope": "tag.st",
                        "settings": {
                            "foreground": "#b0ccff",
                            "fontStyle": ""
                        }
                    },
                    {
                        "scope": "style.markdown.st",
                        "settings": {
                            "foreground": "#febeeb"
                        }
                    }
                ]
            }
        }
    }
}
