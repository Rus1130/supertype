{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SuperType",
    "patterns": [
        { "include": "#raw" },
        { "include": "#comments" },
        { "include": "#markup" },
        { "include": "#header" },
        { "include": "#escapes" },
        { "include": "#tags" },
        { "include": "#mixin" }
    ],
	"repository": {
        "specifics": {
            "patterns": [
                {
                    "name": "specific.st",
                    "match": "\\b(reset|override|default|group|end|instant|off|shared|fill)\\b"
                },
                {
                    "name": "none.specific.st",
                    "match": "\\b(none)\\b"
                }
            ]
        },
        "raw": {
            "patterns": [
                {
                    "name": "string.unstyled.raw.st",
                    "begin": "(?<!\\\\)\\[raw\\]",
                    "end": "(?<!\\\\)\\[raw (end)\\]",
                    "beginCaptures": {
                        "0": { "name": "tag.st" }
                    },
                    "endCaptures": {
                        "0": { "name": "tag.st" },
                        "1": { "name": "specific.st" }
                    },
                    "patterns": []
                }
            ]
        },
        "colors": {
            "patterns": [
                {
                    "name": "color.st",
                    "match": "#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3})\\b"
                },
                {
                    "name": "color.st",
                    "match": "\\b(?:25[0-5]|2[0-4]\\d|1?\\d?\\d),(?:25[0-5]|2[0-4]\\d|1?\\d?\\d),(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.number.st",
                    "match": "\\b-?\\d+(?:\\.\\d+)?\\b"
                }
            ]
        },
        "booleans": {
            "patterns": [
                {
                    "name": "constant.language.boolean.st",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "mixin": {
            "patterns": [
                {
                    "begin": "(?<!\\\\)\\[(mixin)\\s+(\"[^\"]*\")\\]",
                    "beginCaptures": {
                        "0": { "name": "tag.st" },
                        "1": { "name": "tag.st" },
                        "2": { "name": "string.quoted.double.supertype" }
                    },
                    "end": "(?<!\\\\)\\[(mixin)\\s+(end)\\]",
                    "endCaptures": {
                        "0": { "name": "tag.st" },
                        "1": { "name": "tag.st" },
                        "2": { "name": "specific.st" }
                    },
                    "patterns": [
                        { "include": "#comments" },
                        { "include": "#markup" },
                        { "include": "#escapes" },
                        { "include": "#tags" },
                        { "include": "#mixinPlaceholder" }
                    ]
                }
            ]
        },
        "mixinPlaceholder": {
            "patterns": [
                {
                    "name": "param.mixin.st",
                    "match": "<(String|Number|Color|Boolean)>"
                }
            ]
        },
        "tags": {
            "patterns": [
                {
                    "name": "tag.st",
                    "begin": "(?<!\\\\)\\[((?:removelast|custom|customremove|function|tab|gopage|color|bg|speed|speeddefault|newline|linebreak|sleep|glitch|instant|page|ignore|jitter|swap|repeat|resetcolors|accuracy|unscramble|gradient))\\b",
                    "beginCaptures": {
                        "0": { "name": "tag.st" },
                        "1": { "name": "tag.st" }
                    },
                    "end": "(?<!\\\\)\\]",
                    "endCaptures": {
                        "0": { "name": "tag.st" }
                    },
                    "patterns": [
                        { "include": "#mixinPlaceholder" },
                        { "include": "#specifics" },
                        { "include": "#strings" },
                        { "include": "#colors" },
                        { "include": "#numbers" },
                        { "include": "#booleans" },
                        { "include": "#escapes" }
                    ]
                },
                {
                    "name": "tag.st",
                    "begin": "(?<!\\\\)\\[((?:@use|@import|@forceinstant|@forcescroll|@forceseparate))\\b",
                    "beginCaptures": {
                        "0": { "name": "tag.st" },
                        "1": { "name": "attag.tag.st" }
                    },
                    "end": "(?<!\\\\)\\]",
                    "endCaptures": {
                        "0": { "name": "tag.st" }
                    },
                    "patterns": [
                        { "include": "#strings" },
                        { "include": "#specifics" },
                        { "include": "#colors" },
                        { "include": "#numbers" },
                        { "include": "#booleans" },
                        { "include": "#escapes" }
                    ]
                }
            ]
        },
        "header": {
            "patterns": [
                {
                    "name": "meta.header.st",
                    "begin": "\\btypewriter\\s*:\\s*\\{",
                    "beginCaptures": {
                        "0": { "name": "keyword.control.header.st" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "keyword.control.header.st" }
                    },
                    "patterns": [
                        { "include": "#headerObject" }
                    ]
                }
            ]
        },
        "headerObject": {
            "patterns": [
                {
                    "begin": "\\{",
                    "end": "\\}",
                    "beginCaptures": {
                        "0": { "name": "keyword.control.header.st" }
                    },
                    "endCaptures": {
                        "0": { "name": "keyword.control.header.st" }
                    },
                    "patterns": [
                        { "include": "#headerObject" }
                    ]
                },
                {
                    "name": "support.type.property.st",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*:)"
                },
                { "include": "#strings" },
                { "include": "#colors" },
                { "include": "#numbers" },
                { "include": "#booleans" }
            ]
        },
        "markup": {
            "patterns": [
                {
                    "name": "style.markdown.st",
                    "match": "(?<!\\\\)\\*"
                },
                {
                    "name": "style.markdown.st",
                    "match": "(?<!\\\\)\\/"
                },
                {
                    "name": "style.markdown.st",
                    "match": "(?<!\\\\)\\_"
                },
                {
                    "name": "style.markdown.st",
                    "match": "(?<!\\\\)\\-"
                }
            ]
        },
        "escapes": {
            "patterns": [
                {
                    "name": "comment.block.supertype",
                    "match": "\\\\(?=.)"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.supertype",
                    "begin": "(?<!\\\\){{#",
                    "end": "(?<!\\\\)#}}"
                }
            ]
        },
		"strings": {
			"name": "string.quoted.double.supertype",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.supertype",
					"match": "\\\\(?=.)"
				}
			]
		}
	},
	"scopeName": "source.st"
}